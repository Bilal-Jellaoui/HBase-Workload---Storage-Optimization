<?xml version="1.0"?>
<!-- ============================================================
     hbase-site.xml — Configuration HBase corrigée
     Projet BMA — Master Big Data — Université Ibn Tofail
     IMPORTANT : Utilise l'IP réelle 192.168.56.101 et non localhost
     + hbase.wal.provider=filesystem pour éviter le conflit Netty
     ============================================================ -->
<configuration>
  <!-- IP réelle du NameNode (et non localhost) -->
  <property>
    <name>hbase.rootdir</name>
    <value>hdfs://192.168.56.101:9000/hbase</value>
  </property>
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>localhost</value>
  </property>
  <property>
    <name>hbase.cluster.distributed</name>
    <value>true</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>2181</value>
  </property>
  <!-- Fix : désactiver WAL asynchrone pour éviter conflit Protobuf/Netty -->
  <property>
    <name>hbase.wal.provider</name>
    <value>filesystem</value>
  </property>
</configuration>
